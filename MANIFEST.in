include LICENSE README.md pyproject.toml requirements-qualification.txt
recursive-include scripts *.py
recursive-include docs *.md
recursive-include validation *.json *.md *.sha256
recursive-include tests *.py *.json *.md *.txt *.ts *.js *.yaml *.yml *.toml
recursive-include examples *.py *.md *.json *.ts *.js *.yaml *.yml *.toml
global-exclude __pycache__ *.py[cod]
